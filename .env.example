# Full Hostinger mailbox address. This must match the email in the From header.
SMTP_USER=info@nexveins.com

# App Password generated in hPanel -> Emails -> Manage -> Mailboxes.
SMTP_PASS=

# Use smtp.titan.email instead if the mailbox is on Hostinger Titan Email.
SMTP_HOST=smtp.hostinger.com

# 465 = SSL/TLS. If your hosting network blocks 465, use 587 with SMTP_SECURE=false.
SMTP_PORT=465
SMTP_SECURE=true

# Where enquiries are delivered. Defaults to SMTP_USER when omitted.
CONTACT_TO=info@nexveins.com
